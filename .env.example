ANTHROPIC_API_KEY=
# Blind A/B judging (Judge tab): the key that hides which system gave which answer. Set it so the A/B sides stay
# the same across server restarts.
JUDGE_SECRET=
# Data collectors only (src/collect_*.py, src/external/off_download.py): sent in their User-Agent so sites can reach you
CONTACT_EMAIL=

# Optional overrides, shown with their defaults
# OUTLINE=sam3                 bottle outline for fill: sam3, or sam2 for SAM 2.1 only
# MIN_LINE_CONTRAST=15         liquid lines weaker than this come back as unsure
# CROPS=data/crops             crop set for src/match.py (data/crops_whole for the whole-bottle re-cut)
# GALLERY=v1                   gallery version for src/compare_backbones.py
# JUDGE_CLAUDE, JUDGE_OURS     the two prediction files the Judge tab compares (see src/judge_routes.py)
# JUDGE_OUT                    where judgements are appended (data/test_bars/judgements.csv)
